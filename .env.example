# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-key

# Rate Limiting (required for production)
# Option 1: Manual Upstash credentials
UPSTASH_REDIS_REST_URL=your-upstash-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
# Option 2: Vercel Marketplace integration (auto-injected)
# When you connect Upstash via Vercel Marketplace, it injects:
# KV_REST_API_URL, KV_REST_API_TOKEN (used as fallback)
# Either pair works; manual credentials take precedence

# Affiliate Links (required)
# Without this, all /go links redirect to home instead of affiliate URLs
AFFILIATE_CLICK_SECRET=random-secret-string

# Daily click-log cleanup cron (required in production)
# Vercel sends Authorization: Bearer ${CRON_SECRET} to /api/cron/cleanup-clicks
# The route fails closed (401) if this is unset
CRON_SECRET=random-cron-secret

# Contact and brand (leave unset until MX / brand site are live)
# Mailto links stay hidden when NEXT_PUBLIC_SITE_CONTACT_EMAIL is empty
# NEXT_PUBLIC_SITE_CONTACT_EMAIL=aionestopshop25@gmail.com
# Brand links stay plain text when NEXT_PUBLIC_BRAND_URL is empty
# NEXT_PUBLIC_BRAND_URL=
NEXT_PUBLIC_SITE_POSTAL_ADDRESS="<your mailing address>\n<city, state zip>\n<country>"

# Email notifications (optional, used for sponsor request/intake notifications)
# Get API key from resend.com/api-keys
# Free tier: 100 emails/day, 3000/month
# You must verify the 'from' domain (notifications@aionestop.shop) in Resend
# RESEND_API_KEY=re_...

# Operator legal name (for legal pages)
# Defaults to '[LLC NAME]' if not set
# NEXT_PUBLIC_OPERATOR_LEGAL_NAME=

# Affiliate program flag (default OFF)
# When set to 'true', enables paid-links disclosure wording
# NEXT_PUBLIC_AFFILIATE_LIVE=

# Legal V2 Feature Flag (default OFF)
# When set to 'true', enables:
# - Terms Eligibility section (age requirements)
# - Submit form rights checkbox with server enforcement
# - /dmca page and footer links (requires DMCA agent env vars below)
# - Footer Terms section
# NEXT_PUBLIC_LEGAL_V2=true

# DMCA Designated Agent Contact (required when LEGAL_V2 is enabled)
# Without these, the /dmca page returns 404 in production
# Get a PO box or virtual mailbox for the public address
# Register at copyright.gov/dmca-directory ($6, renew every 3 years)
# DMCA_AGENT_NAME=Your Name or Business Name
# DMCA_AGENT_ADDRESS="PO Box 123\nCity, State 12345\nUnited States"
# DMCA_AGENT_EMAIL=dmca@example.com
# DMCA_AGENT_PHONE=+1-555-555-5555

# Optional (DO NOT SET until wired)
# Turnstile (Cloudflare CAPTCHA) - NOT YET WIRED TO SUBMIT FORM
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-site-key
# TURNSTILE_SECRET_KEY=your-secret-key
NEXT_PUBLIC_SITE_URL=https://aionestop.shop
